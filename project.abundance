    {
      "atomType": "Code",
      "x": 0.7747,
      "y": 0.16,
      "uniqueID": "id-835",
      "ioValues": [
        {
          "name": "shape",
          "ioValue": "__GEOMETRY_INPUT__"
        }
      ],
      "interpreterVersion": 1,
      "code": "// Cut in half vertically. For each leaf, trim away it's bottom half.\nfunction run(shape: Assembly) {\n  return shape.onLeafs((leaf) => {\n    const [[xMin, yMin, zMin], [xMax, yMax, zMax]] = leaf.geometry.boundingBox.bounds;\n    const midZ = (zMin + zMax) / 2;\n    const pad = 1;\n    const keep = replicad.makeBox(\n      [xMin - pad, yMin - pad, zMin - pad],\n      [xMax + pad, yMax + pad, midZ]\n    );\n    leaf.geometry = leaf.geometry.intersect(keep);\n    return leaf;\n  });\n}",
      "compiledCode": "\"use strict\";\n// Cut in half vertically. For each leaf, trim away it's bottom half.\nfunction run(shape) {\n    return shape.onLeafs((leaf) => {\n        const [[xMin, yMin, zMin], [xMax, yMax, zMax]] = leaf.geometry.boundingBox.bounds;\n        const midZ = (zMin + zMax) / 2;\n        const pad = 1;\n        const keep = replicad.makeBox([xMin - pad, yMin - pad, zMin - pad], [xMax + pad, yMax + pad, midZ]);\n        leaf.geometry = leaf.geometry.intersect(keep);\n        return leaf;\n    });\n}\n"
    },
    {
      "atomType": "Code",
      "x": 0.7129,
      "y": 0.3457,
      "uniqueID": "id-845",
      "ioValues": [
        {
          "name": "shape",
          "ioValue": "__GEOMETRY_INPUT__"
        },
        {
          "name": "minVolume",
          "ioValue": 0.0625,
          "currentEquation": "slice_thickness * slice_thickness * slice_thickness * 4"
        }
      ],
      "interpreterVersion": 1,
      "code": "// Volume high-pass filter. Exclude shapes and components with\n// a volumne (or area for 2d shapes) below the given threshold.\nfunction run(shape: Assembly, minVolume: number = 1) {\n  return shape.onLeafs((leaf) => {\n    if (leaf.is3D() && replicad.measureVolume(leaf.geometry) >= minVolume) {\n      return leaf;\n    }\n    if (leaf.is2D() && replicad.measureArea(leaf.geometry) >= minVolume) {\n      return leaf;\n    }\n    return undefined;\n  });\n}",
      "compiledCode": "\"use strict\";\n// Volume high-pass filter. Exclude shapes and components with\n// a volumne (or area for 2d shapes) below the given threshold.\nfunction run(shape, minVolume = 1) {\n    return shape.onLeafs((leaf) => {\n        if (leaf.is3D() && replicad.measureVolume(leaf.geometry) >= minVolume) {\n            return leaf;\n        }\n        if (leaf.is2D() && replicad.measureArea(leaf.geometry) >= minVolume) {\n            return leaf;\n        }\n        return undefined;\n    });\n}\n"
    },
